#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener { input-processors = <&zip_temp_layer 5 5000>; };

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <3>;
        };
    };

    macros {
        screen_shot: screen_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 10>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LCMD>;

            label = "SCREEN_SHOT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&none  &none               &none     &none     &none             &none                                         &none        &none  &none      &none             &none                 &none
&none  &kp Q               &kp W     &kp E     &kp R             &kp T                                         &kp Y        &kp U  &kp I      &kp O             &kp P                 &none
&none  &mt LEFT_CONTROL A  &kp S     &kp D     &kp F             &kp G        &none             &none          &kp H        &kp J  &kp K      &kp L             &kp MINUS             &none
&none  &mt LEFT_SHIFT Z    &kp X     &kp C     &kp V             &kp B        &kp TAB           &kp SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT           &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL           &kp LGUI  &kp LALT  &lt 4 LANGUAGE_2  &lt 2 SPACE  &lt 3 LANGUAGE_1  &kp BACKSPACE  &lt 1 ENTER  &none  &none      &kp SINGLE_QUOTE  &kp ESCAPE            &none
            >;
        };

        marks {
            bindings = <
&trans  &trans                &trans           &trans        &trans     &trans                          &trans  &trans                &trans                 &trans         &trans  &trans
&trans  &trans                &kp AMPERSAND    &kp ASTERISK  &kp TILDE  &kp UNDERSCORE                  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &trans  &trans
&trans  &kp GRAVE             &kp DOLLAR       &kp PERCENT   &kp CARET  &trans          &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &trans  &trans
&trans  &mt LEFT_SHIFT MINUS  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &trans          &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE       &trans  &trans
&trans  &trans                &trans           &trans        &trans     &trans          &trans  &trans  &trans  &trans                &trans                 &trans         &trans  &trans
            >;
        };

        number {
            bindings = <
&trans  &trans        &trans        &trans        &trans     &trans                                &trans          &trans  &trans  &trans           &trans   &trans
&trans  &kp N7        &kp N8        &kp N9        &kp PLUS   &kp ASTERISK                          &trans          &kp F7  &kp F8  &kp F9           &kp F12  &trans
&trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS  &kp SLASH     &trans  &trans          &trans          &kp F4  &kp F5  &kp F6           &kp F11  &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &kp PERCENT   &trans  &kp UP_ARROW    &trans          &kp F1  &kp F2  &kp F3           &kp F10  &trans
&trans  &kp N0        &kp PERIOD    &kp COMMA     &trans     &trans        &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &trans  &trans  &kp RIGHT_ARROW  &trans   &trans
            >;
        };

        machine {
            bindings = <
&trans  &trans          &trans            &trans           &trans                &trans                                      &trans    &trans        &trans         &trans          &trans      &trans
&trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC                        &kp HOME  &kp PG_UP     &kp PAGE_DOWN  &kp END         &kp ESCAPE  &trans
&trans  &kp C_VOL_DN    &kp C_MUTE        &kp C_VOLUME_UP  &trans                &trans                &trans  &trans        &kp LEFT  &kp UP_ARROW  &kp RIGHT      &kp DOWN_ARROW  &kp TAB     &trans
&trans  &trans          &trans            &trans           &trans                &trans                &trans  &screen_shot  &trans    &trans        &trans         &trans          &trans      &trans
&trans  &trans          &trans            &trans           &trans                &trans                &trans  &trans        &trans    &trans        &trans         &trans          &trans      &trans
            >;
        };

        bluetooth {
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans       &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mo 6   &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        mouse_scroll {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };
    };
};
