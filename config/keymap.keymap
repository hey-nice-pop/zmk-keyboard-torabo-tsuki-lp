#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener { input-processors = <&zip_temp_layer 6 10000>; };

&mt { flavor = "balanced"; };

/ {
    combos {
        compatible = "zmk,combos";

        mission_control {
            bindings = <&mission_control>;
            key-positions = <34 35 33>;
        };

        mission_control_minus {
            bindings = <&mission_control_minus>;
            key-positions = <34 33>;
        };

        mission_control_plus {
            bindings = <&mission_control_plus>;
            key-positions = <34 35>;
        };
    };

    macros {
        screen_shot: screen_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 10>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LCMD>;

            label = "SCREEN_SHOT";
        };

        mission_control: mission_control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_wait_time 10>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "MISSION_CONTROL";
        };

        mission_control_minus: mission_control_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_wait_time 10>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "MISSION_CONTROL_MINUS";
        };

        mission_control_plus: mission_control_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_wait_time 10>,
                <&macro_tap>,
                <&kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "MISSION_CONTROL_PLUS";
        };

        language_toggle: language_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_wait_time 40>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_wait_time 20>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "LANGUAGE_TOGGLE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&none  &none               &none     &none     &none        &none                                         &none        &none  &none      &none      &none                 &none
&none  &kp Q               &kp W     &kp E     &kp R        &kp T                                         &kp Y        &kp U  &kp I      &kp O      &kp P                 &none
&none  &mt LEFT_CONTROL A  &kp S     &kp D     &kp F        &kp G        &none             &none          &kp H        &kp J  &lt 7 K    &kp L      &kp MINUS             &none
&none  &mt LEFT_SHIFT Z    &kp X     &kp C     &kp V        &kp B        &lt 4 TAB         &lt 5 SQT      &kp N        &kp M  &kp COMMA  &kp DOT    &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL           &kp LGUI  &kp LALT  &lt 3 LANG1  &lt 2 SPACE  &language_toggle  &kp BACKSPACE  &lt 1 ENTER  &none  &none      &kp COLON  &kp ESCAPE            &none
            >;
        };

        number,marks {
            bindings = <
&trans  &trans    &trans  &trans          &trans          &trans                           &trans     &trans    &trans     &trans                &trans                 &trans
&trans  &kp N1    &kp N2  &kp N3          &kp N4          &kp N5                           &kp N6     &kp N7    &kp N8     &kp N9                &kp N0                 &trans
&trans  &kp EXCL  &kp AT  &kp HASH        &kp DOLLAR      &kp PERCENT      &trans  &trans  &kp CARET  &kp AMPS  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans     &trans    &trans     &trans                &trans                 &trans
&trans  &trans    &trans  &trans          &trans          &trans           &trans  &trans  &trans     &trans    &trans     &kp SEMI              &trans                 &trans
            >;
        };

        brackets {
            bindings = <
&trans  &trans  &trans  &trans          &trans          &trans                           &trans     &trans         &trans                &trans                 &trans     &trans
&trans  &trans  &trans  &trans          &trans          &trans                           &kp PIPE   &kp BACKSLASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &trans
&trans  &trans  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans  &kp TILDE  &kp DQT        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans     &trans
&trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &kp GRAVE  &kp SQT        &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans     &trans
&trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans     &trans         &trans                &trans                 &kp PLUS   &trans
            >;
        };

        arrow {
            bindings = <
&trans  &trans   &trans   &trans          &trans          &trans                           &trans  &trans  &trans  &trans  &trans   &trans
&trans  &kp F1   &kp F2   &kp F3          &kp F4          &kp F5                           &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F11  &kp F12  &trans          &kp UP_ARROW    &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        machine {
            bindings = <
&trans  &trans  &trans  &trans                &trans                &trans                        &trans    &trans        &trans         &trans        &trans  &trans
&trans  &trans  &trans  &trans                &trans                &trans                        &trans    &kp C_PREV    &kp C_PP       &kp C_NEXT    &trans  &trans
&trans  &trans  &trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &trans  &trans        &trans    &kp C_VOL_DN  &kp C_MUTE     &kp C_VOL_UP  &trans  &trans
&trans  &trans  &trans  &trans                &trans                &trans  &trans  &screen_shot  &kp HOME  &kp PAGE_UP   &kp PAGE_DOWN  &kp END       &trans  &trans
&trans  &trans  &trans  &trans                &trans                &trans  &trans  &trans        &trans    &trans        &trans         &trans        &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans       &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans      &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &to 0   &mkp LCLK  &mo 7   &mkp RCLK  &trans  &trans
&trans  &kp LSHIFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
            >;
        };

        mouse_scroll {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans      &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &to 0   &mkp LCLK  &trans  &mkp RCLK  &trans  &trans
&trans  &kp LSHIFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
            >;
        };
    };
};
